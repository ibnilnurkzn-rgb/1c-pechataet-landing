# Telegram-бот для приёма лидов и уведомлений об оплате.
# Токен выдаётся @BotFather; chat_id — id чата, куда бот должен писать
# (для личного чата — id вашего Telegram-аккаунта: напишите боту что угодно,
# затем откройте https://api.telegram.org/bot<TOKEN>/getUpdates и возьмите chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Данные из личного кабинета ЮKassa (yookassa.ru → Настройки → Магазин / API).
# shopId не секретен, secretKey — секретный ключ, храните только на сервере.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
